#===============================================================
# 租房管家 全局配置文件 info.gwt
#---------------------------------------------------------------
# 说明：
#   1. 本文件为「本地配置文本文件」，禁止联网、禁止云端存储；
#   2. 首次启动 APP 时会被释放到应用私有目录（files/info.gwt），
#      之后 APP 读写的都是私有目录里的那一份，本文件仅作为默认模板；
#   3. 格式为「键=值」，一行一个，# 开头为注释，修改后即时生效；
#   4. 也可以直接在 APP 的「设置中心」里修改，APP 会自动回写本文件。
#===============================================================

#—— 计费参数 ——————————————————————————————————————
# 水费单价（元/吨）
water_price=6
# 电费单价（元/度）
elec_price=1.2

#—— 通知提醒 ——————————————————————————————————————
# 房租/水电费未缴费提醒：提前多少天开始提醒（天）
remind_days=7
# 租期到期提醒：提前多少天开始提醒（天）
expire_remind_days=30
# 是否开启系统通知（1=开启 0=关闭）
notify_enabled=1
# 是否开启澎湃OS/HyperOS 焦点通知（1=开启 0=关闭）
focus_enabled=1

#—— 运行期数据（由 APP 自动维护，请勿手工编辑）——————————
# 内置通知中心已读消息 ID 列表，逗号分隔
notice_read_ids=
